diff --git a/src/fm1/fm1_filter.h b/src/fm1/fm1_filter.h
new file mode 100644
index 0000000..1c8eb47
--- /dev/null
+++ b/src/fm1/fm1_filter.h
@@ -0,0 +1,130 @@
+// FM-1: a filter over everything the game plays. The FM-1 is a synthesizer, after all.
+//
+// One knob sweeps it: at the centre it is off (the sound is not touched at all); turned left it is a low-pass
+// that closes down from 8000 Hz to 80 Hz; turned right, a high-pass that opens up from 80 Hz to 8000 Hz.
+// A second knob sets the resonance, the peak at the cutoff. fm1_controls.c owns the two settings
+// (fm1_filter_pos, fm1_filter_res); whatever plays the sound (the device's audio interrupt, the browser build)
+// calls fm1_filter_run on each block of 16-bit stereo before it goes out.
+//
+// The filter is a state-variable filter in its trapezoidal form (Zavalishin; Simper's "SvfLinearTrapOptimised2"):
+// stable at every cutoff and resonance, and well behaved while the cutoff moves. Arithmetic is fixed point with
+// 64-bit products (one instruction on the FM-1's CPU): coefficients in Q24, samples carried with 8 extra bits.
+// Changes of setting are ramped across one block, and off <-> on is a crossfade, so nothing clicks.
+// firmware/tests/filter_test.c in the fm1-doom repository tests it on a PC.
+//
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <stdint.h>
+
+#define FM1_FILTER_STEPS 40             // knob positions each side of off: -40 .. -1 low-pass, 0 off, 1 .. 40 high-pass
+#define FM1_FILTER_RES 8                // resonance settings 0 .. 7
+#define FM1_FILTER_RES_DEFAULT 3
+
+// tan(pi * f / 44118) in Q24 for the 40 cutoffs, 80 Hz to 8000 Hz in equal ratios, and the same in Hz for showing
+static const int32_t FM1_FILTER_G[FM1_FILTER_STEPS] = {
+       95576,   107555,   121036,   136207,   153280,   172492,   194113,   218445,
+      245828,   276644,   311325,   350356,   394283,   443723,   499368,   562001,
+      632503,   711868,   801218,   901822,  1015112,  1142713,  1286465,  1448461,
+     1631082,  1837054,  2069501,  2332025,  2628805,  2964722,  3345531,  3778090,
+     4270675,  4833431,  5479020,  6223574,  7088157,  8101049,  9301466, 10745880
+};
+static const uint16_t FM1_FILTER_HZ[FM1_FILTER_STEPS] __attribute__((unused)) = {
+      80,   90,  100,  115,  130,  145,  160,  185,  205,  230,
+     260,  295,  330,  370,  420,  470,  530,  595,  670,  755,
+     850,  955, 1070, 1210, 1360, 1530, 1720, 1940, 2180, 2460,
+    2760, 3110, 3500, 3940, 4430, 4990, 5610, 6320, 7110, 8000
+};
+// 1 / Q in Q24, for Q = 0.7071, 1.0, 1.4, 2.0, 2.8, 4.0, 5.6, 8.0
+static const int32_t FM1_FILTER_K[FM1_FILTER_RES] = {
+    23726794, 16777216, 11983726,  8388608,  5991863,  4194304,  2995931,  2097152
+};
+
+typedef struct {
+    int32_t ic1[2], ic2[2];             // the two integrators of each channel (samples << 8)
+    int32_t c[5];                       // coefficients in use: a1, a2, a3, k, output level (Q24)
+    int32_t t[5];                       // ... and where they are heading
+    int32_t wet, twet;                  // 0 = the sound as it came, 256 = all filter
+    int8_t pos, res, high, set;         // the settings c[] was made for; high: 1 = high-pass, 0 = low-pass
+} fm1_filter_t;
+
+// which cutoff a knob position means (index into the tables)
+static inline int fm1_filter_step(int pos) { return pos < 0 ? FM1_FILTER_STEPS + pos : pos - 1; }
+
+static inline int32_t fm1_filter_mul(int32_t c, int32_t v) { return (int32_t)(((int64_t)c * v) >> 24); }
+// A guard on the integrators, not a limiter: full scale is 2^23 here, so 2^28 is 30 dB above the loudest input.
+// With every state inside it, and a1 <= 1, a2 <= 0.64, a3 <= 0.41, k <= 1.42 (the tables' extremes), each sum in
+// fm1_filter_pass stays below 1.3 * 2^30: plain 32-bit arithmetic cannot overflow.
+#define FM1_FILTER_TOP (1 << 28)
+static inline int32_t fm1_filter_sat(int32_t v) { return v > FM1_FILTER_TOP ? FM1_FILTER_TOP : v < -FM1_FILTER_TOP ? -FM1_FILTER_TOP : v; }
+
+// one channel of one block: the coefficients move from c[] towards t[] by d[] a frame, the mix by dw
+static inline void fm1_filter_pass(fm1_filter_t *f, int16_t *p, uint32_t frames, int ch, const int32_t *d, int32_t dw)
+{
+    int32_t c0 = f->c[0], c1 = f->c[1], c2 = f->c[2], c3 = f->c[3], c4 = f->c[4], w = f->wet << 16;
+    int32_t ic1 = f->ic1[ch], ic2 = f->ic2[ch];
+    const int high = f->high, fading = dw != 0;
+    for (; frames; frames--, p += 2) {
+        int32_t x = (int32_t)*p << 8, v3 = x - ic2, v1, v2, y;
+        c0 += d[0]; c1 += d[1]; c2 += d[2]; c3 += d[3]; c4 += d[4];
+        v1 = fm1_filter_mul(c0, ic1) + fm1_filter_mul(c1, v3);
+        v2 = ic2 + fm1_filter_mul(c1, ic1) + fm1_filter_mul(c2, v3);
+        ic1 = fm1_filter_sat(2 * v1 - ic1);
+        ic2 = fm1_filter_sat(2 * v2 - ic2);
+        y = fm1_filter_mul(c4, high ? x - fm1_filter_mul(c3, v1) - v2 : v2);
+        if (fading) {                           // coming on or going off: part filter, part the sound as it came
+            w += dw;
+            y = x + (int32_t)(((int64_t)(y - x) * (w >> 16)) >> 8);
+        }
+        y = (y + 128) >> 8;
+        *p = (int16_t)(y > 32767 ? 32767 : y < -32768 ? -32768 : y);
+    }
+    f->ic1[ch] = ic1;
+    f->ic2[ch] = ic2;
+}
+
+// One block of interleaved stereo, in place. pos: -FM1_FILTER_STEPS .. FM1_FILTER_STEPS; res: 0 .. FM1_FILTER_RES - 1.
+// Off (pos 0, once any fade has finished) returns without touching a sample.
+static void fm1_filter_run(fm1_filter_t *f, int16_t *buf, uint32_t frames, int pos, int res)
+{
+    uint32_t i;
+    int32_t d[5], dw;
+    if (!frames)
+        return;
+    if (pos < -FM1_FILTER_STEPS) pos = -FM1_FILTER_STEPS;
+    if (pos > FM1_FILTER_STEPS) pos = FM1_FILTER_STEPS;
+    if (res < 0) res = 0;
+    if (res >= FM1_FILTER_RES) res = FM1_FILTER_RES - 1;
+    if (!f->set || pos != f->pos || res != f->res) {
+        if (pos) {
+            const int64_t one = (int64_t)1 << 24;
+            int32_t g = FM1_FILTER_G[fm1_filter_step(pos)], k = FM1_FILTER_K[res];
+            int32_t a1 = (int32_t)((one << 24) / (one + (((int64_t)g * (g + k)) >> 24)));
+            int32_t level = (1 << 23) + k / 2;      // quieter as the resonance rises, so its peak has somewhere to go
+            f->t[0] = a1;
+            f->t[1] = fm1_filter_mul(g, a1);
+            f->t[2] = fm1_filter_mul(g, f->t[1]);
+            f->t[3] = k;
+            f->t[4] = level > (1 << 24) ? 1 << 24 : level;
+            if (!f->wet) {                          // coming on from off: start at the new settings, with empty integrators
+                for (i = 0; i < 5; i++) f->c[i] = f->t[i];
+                f->ic1[0] = f->ic1[1] = f->ic2[0] = f->ic2[1] = 0;
+            }
+            f->high = pos > 0;
+            f->twet = 256;
+        } else
+            f->twet = 0;                            // going off: fade out with the filter as it is
+        f->pos = (int8_t)pos;
+        f->res = (int8_t)res;
+        f->set = 1;
+    }
+    if (!f->wet && !f->twet)
+        return;
+    for (i = 0; i < 5; i++)
+        d[i] = (f->t[i] - f->c[i]) / (int32_t)frames;
+    dw = ((f->twet - f->wet) << 16) / (int32_t)frames;
+    fm1_filter_pass(f, buf, frames, 0, d, dw);
+    fm1_filter_pass(f, buf + 1, frames, 1, d, dw);
+    for (i = 0; i < 5; i++)
+        f->c[i] = f->t[i];
+    f->wet = f->twet;
+}
diff --git a/src/fm1/fm1_web.c b/src/fm1/fm1_web.c
index 739c2bc..a8ed35e 100644
--- a/src/fm1/fm1_web.c
+++ b/src/fm1/fm1_web.c
@@ -7,6 +7,7 @@
 #include <stdint.h>
 #include <string.h>
 #include "fm1.h"
+#include "fm1_filter.h"
 #include "../tiny.whd.h"
 
 static uint16_t fm1_lcd[240 * 240];
@@ -69,11 +70,13 @@ EMSCRIPTEN_KEEPALIVE uint32_t fm1_web_frames(void) { return fm1_frames; }
 
 // the page's audio callback: frames of 16-bit stereo at the AudioContext's rate
 static int16_t fm1_web_pcm[4096 * 2];
+static fm1_filter_t fm1_web_filter;
 EMSCRIPTEN_KEEPALIVE int16_t *fm1_web_audio(int frames, int rate)
 {
     if (frames > 4096)
         frames = 4096;
     fm1_audio_read(fm1_web_pcm, (uint32_t)frames, (uint32_t)rate);
+    fm1_filter_run(&fm1_web_filter, fm1_web_pcm, (uint32_t)frames, fm1_filter_pos, fm1_filter_res);   // tuned for 44.1 kHz
     return fm1_web_pcm;
 }
 
