+    // the filter: KNOB 1 sweeps, and stops at the centre (off) on its way across; KNOB 2 resonance; EDIT off
+    if (enc[FM1_ENC_K1] || (pressed & (1u << FM1_BTN_EDIT))) {
+        int old = fm1_filter_pos, pos = old + enc[FM1_ENC_K1];
+        if ((pressed & (1u << FM1_BTN_EDIT)) || (old < 0 && pos > 0) || (old > 0 && pos < 0))
