diff --git a/src/fm1/fm1_drive.h b/src/fm1/fm1_drive.h
new file mode 100644
index 0000000..7815528
--- /dev/null
+++ b/src/fm1/fm1_drive.h
@@ -0,0 +1,80 @@
+// FM-1: drive, a distortion over everything the game plays, ahead of the filter (fm1_filter.h).
+//
+// One knob: off (the sound is not touched at all), then 16 steps. Each step turns the sound up further into a
+// soft clipper (y = 1.5x - 0.5x^3, flat beyond full scale), from 4 times, where the music's peaks begin to
+// round off, to 64 times, where nearly half of it is flat-topped: fuzz. The result is turned back down so that
+// the game's own sound gets only a little louder as the knob rises: the levels below were set on five seconds of
+// E1M1's music from the browser build, to come out 1 dB louder (RMS) at the first step and 4 dB at the last.
+// fm1_controls.c owns the setting (fm1_drive_amt); whatever plays the sound calls fm1_drive_run on each block
+// of 16-bit stereo. A change of step is ramped across one block and off <-> on is a crossfade, so nothing clicks.
+// firmware/tests/drive_test.c in the fm1-doom repository tests it on a PC.
+//
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <stdint.h>
+
+#define FM1_DRIVE_STEPS 16              // knob positions above off
+
+// the gain into the clipper in Q8, 4 to 64 times in equal ratios, and the level out of it in Q15
+static const uint16_t FM1_DRIVE_GAIN[FM1_DRIVE_STEPS] = {
+    1024,  1232,  1482,  1783,  2145,  2580,  3104,  3734,  4493,  5405,  6502,  7822,  9410, 11321, 13619, 16384
+};
+static const uint16_t FM1_DRIVE_LEVEL[FM1_DRIVE_STEPS] = {
+    6487,  5654,  4977,  4441,  4022,  3706,  3498,  3401,  3362,  3353,  3362,  3384,  3416,  3455,  3500,  3549
+};
+
+typedef struct {
+    int32_t g, l;                       // gain and level in use, each with 8 extra bits (so a ramp has something to step by)
+    int32_t wet;                        // 0 = the sound as it came .. 256 << 16 = all drive
+    int8_t amt;                         // the step g and l were last heading for
+} fm1_drive_t;
+
+// one sample through the clipper: gain in Q8, level in Q15
+static inline int32_t fm1_drive_shape(int32_t s, int32_t gain, int32_t level)
+{
+    int32_t x = (s * gain) >> 8;
+    if (x > 32767) x = 32767;
+    if (x < -32767) x = -32767;
+    x = (x * (49152 - (((x * x) >> 15) >> 1))) >> 15;       // 1.5x - 0.5x^3 with full scale as 1
+    return (x * level) >> 15;
+}
+
+// One block of interleaved stereo, in place. amt: 0 (off) .. FM1_DRIVE_STEPS.
+// Off (once any fade has finished) returns without touching a sample.
+static void fm1_drive_run(fm1_drive_t *d, int16_t *buf, uint32_t frames, int amt)
+{
+    int32_t tg, tl, tw, dg, dl, dw, g, l, w;
+    uint32_t i;
+    if (!frames)
+        return;
+    if (amt < 0) amt = 0;
+    if (amt > FM1_DRIVE_STEPS) amt = FM1_DRIVE_STEPS;
+    if (!amt && !d->wet)
+        return;
+    if (amt) {
+        tg = (int32_t)FM1_DRIVE_GAIN[amt - 1] << 8;
+        tl = (int32_t)FM1_DRIVE_LEVEL[amt - 1] << 8;
+        tw = 256 << 16;
+        if (!d->wet) {                  // coming on from off: start at the new step
+            d->g = tg;
+            d->l = tl;
+        }
+    } else {                            // going off: fade out with the drive as it is
+        tg = d->g;
+        tl = d->l;
+        tw = 0;
+    }
+    d->amt = (int8_t)amt;
+    g = d->g; l = d->l; w = d->wet;
+    dg = (tg - g) / (int32_t)frames;
+    dl = (tl - l) / (int32_t)frames;
+    dw = (tw - w) / (int32_t)frames;
+    for (i = 0; i < frames; i++, buf += 2) {
+        int32_t a = buf[0], b = buf[1], m;
+        g += dg; l += dl; w += dw;
+        m = w >> 16;
+        buf[0] = (int16_t)(a + (((fm1_drive_shape(a, g >> 8, l >> 8) - a) * m) >> 8));
+        buf[1] = (int16_t)(b + (((fm1_drive_shape(b, g >> 8, l >> 8) - b) * m) >> 8));
+    }
+    d->g = tg; d->l = tl; d->wet = tw;
+}
