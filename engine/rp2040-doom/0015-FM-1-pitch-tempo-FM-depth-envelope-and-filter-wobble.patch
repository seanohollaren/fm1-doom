diff --git a/src/fm1/fm1_drive.h b/src/fm1/fm1_drive.h
deleted file mode 100644
index 7815528..0000000
--- a/src/fm1/fm1_drive.h
+++ /dev/null
@@ -1,80 +0,0 @@
-// FM-1: drive, a distortion over everything the game plays, ahead of the filter (fm1_filter.h).
-//
-// One knob: off (the sound is not touched at all), then 16 steps. Each step turns the sound up further into a
-// soft clipper (y = 1.5x - 0.5x^3, flat beyond full scale), from 4 times, where the music's peaks begin to
-// round off, to 64 times, where nearly half of it is flat-topped: fuzz. The result is turned back down so that
-// the game's own sound gets only a little louder as the knob rises: the levels below were set on five seconds of
-// E1M1's music from the browser build, to come out 1 dB louder (RMS) at the first step and 4 dB at the last.
-// fm1_controls.c owns the setting (fm1_drive_amt); whatever plays the sound calls fm1_drive_run on each block
-// of 16-bit stereo. A change of step is ramped across one block and off <-> on is a crossfade, so nothing clicks.
-// firmware/tests/drive_test.c in the fm1-doom repository tests it on a PC.
-//
-// SPDX-License-Identifier: GPL-2.0-or-later
-#pragma once
-#include <stdint.h>
-
-#define FM1_DRIVE_STEPS 16              // knob positions above off
-
-// the gain into the clipper in Q8, 4 to 64 times in equal ratios, and the level out of it in Q15
-static const uint16_t FM1_DRIVE_GAIN[FM1_DRIVE_STEPS] = {
-    1024,  1232,  1482,  1783,  2145,  2580,  3104,  3734,  4493,  5405,  6502,  7822,  9410, 11321, 13619, 16384
-};
-static const uint16_t FM1_DRIVE_LEVEL[FM1_DRIVE_STEPS] = {
-    6487,  5654,  4977,  4441,  4022,  3706,  3498,  3401,  3362,  3353,  3362,  3384,  3416,  3455,  3500,  3549
-};
-
-typedef struct {
-    int32_t g, l;                       // gain and level in use, each with 8 extra bits (so a ramp has something to step by)
-    int32_t wet;                        // 0 = the sound as it came .. 256 << 16 = all drive
-    int8_t amt;                         // the step g and l were last heading for
-} fm1_drive_t;
-
-// one sample through the clipper: gain in Q8, level in Q15
-static inline int32_t fm1_drive_shape(int32_t s, int32_t gain, int32_t level)
-{
-    int32_t x = (s * gain) >> 8;
-    if (x > 32767) x = 32767;
-    if (x < -32767) x = -32767;
-    x = (x * (49152 - (((x * x) >> 15) >> 1))) >> 15;       // 1.5x - 0.5x^3 with full scale as 1
-    return (x * level) >> 15;
-}
-
-// One block of interleaved stereo, in place. amt: 0 (off) .. FM1_DRIVE_STEPS.
-// Off (once any fade has finished) returns without touching a sample.
-static void fm1_drive_run(fm1_drive_t *d, int16_t *buf, uint32_t frames, int amt)
-{
-    int32_t tg, tl, tw, dg, dl, dw, g, l, w;
-    uint32_t i;
-    if (!frames)
-        return;
-    if (amt < 0) amt = 0;
-    if (amt > FM1_DRIVE_STEPS) amt = FM1_DRIVE_STEPS;
-    if (!amt && !d->wet)
-        return;
-    if (amt) {
-        tg = (int32_t)FM1_DRIVE_GAIN[amt - 1] << 8;
-        tl = (int32_t)FM1_DRIVE_LEVEL[amt - 1] << 8;
-        tw = 256 << 16;
-        if (!d->wet) {                  // coming on from off: start at the new step
-            d->g = tg;
-            d->l = tl;
-        }
-    } else {                            // going off: fade out with the drive as it is
-        tg = d->g;
-        tl = d->l;
-        tw = 0;
-    }
-    d->amt = (int8_t)amt;
-    g = d->g; l = d->l; w = d->wet;
-    dg = (tg - g) / (int32_t)frames;
-    dl = (tl - l) / (int32_t)frames;
-    dw = (tw - w) / (int32_t)frames;
-    for (i = 0; i < frames; i++, buf += 2) {
-        int32_t a = buf[0], b = buf[1], m;
-        g += dg; l += dl; w += dw;
-        m = w >> 16;
-        buf[0] = (int16_t)(a + (((fm1_drive_shape(a, g >> 8, l >> 8) - a) * m) >> 8));
-        buf[1] = (int16_t)(b + (((fm1_drive_shape(b, g >> 8, l >> 8) - b) * m) >> 8));
-    }
-    d->g = tg; d->l = tl; d->wet = tw;
-}
diff --git a/src/fm1/fm1_filter.h b/src/fm1/fm1_filter.h
index 1c8eb47..75ee5da 100644
--- a/src/fm1/fm1_filter.h
+++ b/src/fm1/fm1_filter.h
@@ -10,6 +10,10 @@
 // stable at every cutoff and resonance, and well behaved while the cutoff moves. Arithmetic is fixed point with
 // 64-bit products (one instruction on the FM-1's CPU): coefficients in Q24, samples carried with 8 extra bits.
 // Changes of setting are ramped across one block, and off <-> on is a crossfade, so nothing clicks.
+//
+// A third setting, the wobble (fm1_filter_wobble), swings the cutoff to and fro about where the sweep knob left
+// it: a triangle in knob steps, 8 steps each way (about an octave and a third), at one of 11 speeds from a
+// quarter of a hertz to 8 Hz. For that the filter can sit between two knob steps (fm1_filter_run_at).
 // firmware/tests/filter_test.c in the fm1-doom repository tests it on a PC.
 //
 // SPDX-License-Identifier: GPL-2.0-or-later
@@ -44,11 +48,34 @@ typedef struct {
     int32_t c[5];                       // coefficients in use: a1, a2, a3, k, output level (Q24)
     int32_t t[5];                       // ... and where they are heading
     int32_t wet, twet;                  // 0 = the sound as it came, 256 = all filter
-    int8_t pos, res, high, set;         // the settings c[] was made for; high: 1 = high-pass, 0 = low-pass
+    int16_t at;                         // the settings t[] was made for: the position in 256ths of a knob step,
+    int8_t res, high, set;              // the resonance; high: 1 = high-pass, 0 = low-pass
+    uint32_t lfo;                       // the wobble's phase, a full turn in 2^32
 } fm1_filter_t;
 
 // which cutoff a knob position means (index into the tables)
 static inline int fm1_filter_step(int pos) { return pos < 0 ? FM1_FILTER_STEPS + pos : pos - 1; }
+// ... and the cutoff's tan() for a position in 256ths of a step, on a straight line between the table's entries
+// (they are 12 % apart, so the line is within half a percent of the curve)
+static inline int32_t fm1_filter_g(int at)
+{
+    int i = at < 0 ? FM1_FILTER_STEPS * 256 + at : at - 256, n;
+    if (i < 0) i = 0;
+    n = i >> 8;
+    if (n >= FM1_FILTER_STEPS - 1)
+        return FM1_FILTER_G[FM1_FILTER_STEPS - 1];
+    return FM1_FILTER_G[n] + (int32_t)(((int64_t)(FM1_FILTER_G[n + 1] - FM1_FILTER_G[n]) * (i & 255)) >> 8);
+}
+
+// the wobble: its speeds as phase a frame at 44118 Hz (hz * 2^32 / 44118), and how far it swings
+#define FM1_WOBBLE_STEPS 11
+#define FM1_WOBBLE_DEPTH 8              // knob steps each way
+static const uint32_t FM1_WOBBLE_INC[FM1_WOBBLE_STEPS] = {
+    24338, 34419, 48676, 68838, 97352, 137676, 194704, 275353, 389407, 550705, 778815
+};
+static const char *const FM1_WOBBLE_HZ[FM1_WOBBLE_STEPS] __attribute__((unused)) = {
+    "0.25", "0.35", "0.5", "0.7", "1", "1.4", "2", "2.8", "4", "5.6", "8"
+};
 
 static inline int32_t fm1_filter_mul(int32_t c, int32_t v) { return (int32_t)(((int64_t)c * v) >> 24); }
 // A guard on the integrators, not a limiter: full scale is 2^23 here, so 2^28 is 30 dB above the loudest input.
@@ -82,22 +109,45 @@ static inline void fm1_filter_pass(fm1_filter_t *f, int16_t *p, uint32_t frames,
     f->ic2[ch] = ic2;
 }
 
-// One block of interleaved stereo, in place. pos: -FM1_FILTER_STEPS .. FM1_FILTER_STEPS; res: 0 .. FM1_FILTER_RES - 1.
-// Off (pos 0, once any fade has finished) returns without touching a sample.
-static void fm1_filter_run(fm1_filter_t *f, int16_t *buf, uint32_t frames, int pos, int res)
+// Where the filter is for the block about to be played, in 256ths of a knob step: the sweep knob's position,
+// swung by the wobble (0: none; 1 .. FM1_WOBBLE_STEPS: its speed). It never swings across the centre or past
+// the ends, and an idle wobble waits in the middle of its swing. Call it once a block, wobbling or not.
+static inline int fm1_filter_swing(fm1_filter_t *f, uint32_t frames, int pos, int wobble)
+{
+    int32_t tri, at;
+    if (pos < -FM1_FILTER_STEPS) pos = -FM1_FILTER_STEPS;
+    if (pos > FM1_FILTER_STEPS) pos = FM1_FILTER_STEPS;
+    if (!pos || wobble <= 0) {
+        f->lfo = 0x40000000u;
+        return pos * 256;
