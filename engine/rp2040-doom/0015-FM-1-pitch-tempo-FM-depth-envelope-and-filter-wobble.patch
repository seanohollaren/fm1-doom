+        n = n < 0 ? 0 : n > 0x3f ? 0x3f : n;
+        voice->mod_volume = data->modulator.scale | n;
+        OPL_WriteRegister((OPL_REGS_LEVEL + voice->op1) | voice->array,
+                          voice->mod_volume);
+    }
+
+    // The envelope of the operators that are heard directly: the carrier,
+    // and the other one too when the two are simply added together.
+
