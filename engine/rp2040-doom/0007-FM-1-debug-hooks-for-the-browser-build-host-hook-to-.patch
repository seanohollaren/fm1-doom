diff --git a/src/fm1/fm1_debug.c b/src/fm1/fm1_debug.c
new file mode 100644
index 0000000..d7df838
--- /dev/null
+++ b/src/fm1/fm1_debug.c
@@ -0,0 +1,52 @@
+// Browser build only: dump the level's thinkers to the console (Module._fm1_web_dump()).
+#include <stdio.h>
+#include "doomdef.h"
+#include "doom/p_local.h"
+#include "doom/doomstat.h"
+extern thinker_t thinkercap;
+int fm1_web_dump(void)
+{
+    int n = 0, shown = 0;
+    if (gamestate != GS_LEVEL)
+        return -1;                       /* no level: the thinker list is not valid */
+    for (thinker_t *t = thinker_next(&thinkercap); t != &thinkercap; t = thinker_next(t), n++) {
+        if (t->function == ThinkF_P_MobjThinker) {
+            mobj_t *m = (mobj_t *)t;
+            if ((m->flags & MF_COUNTKILL) && shown < 6) {
+                shown++;
+                printf("mobj type %d state %d tics %d flags %08x static %d x %d y %d\n", (int)m->type, (int)mobj_state_num(m), (int)m->tics,
+                       (unsigned)m->flags, (int)mobj_is_static(m), m->xy.x >> 16, m->xy.y >> 16);
+            }
+        }
+    }
+    if (players[0].mo) {
+        mobj_t *pm = players[0].mo;
+        printf("player x %d y %d angle %u\n", pm->xy.x >> 16, pm->xy.y >> 16, (unsigned)(mobj_angle(pm) >> 24));
+        for (thinker_t *t = thinker_next(&thinkercap); t != &thinkercap; t = thinker_next(t))
+            if (t->function == ThinkF_P_MobjThinker) {
+                mobj_t *m = (mobj_t *)t;
+                int dx = (m->xy.x - pm->xy.x) >> 16, dy = (m->xy.y - pm->xy.y) >> 16;
+                if (m != pm && dx * dx + dy * dy < 900 * 900)
+                    printf("near: type %d doomednum %d state %d tics %d flags %08x dx %d dy %d\n", (int)m->type, mobj_info(m)->doomednum,
+                           (int)mobj_state_num(m), (int)m->tics, (unsigned)m->flags, dx, dy);
+            }
+    }
+    printf("thinkers %d gametic %d leveltime %d paused %d\n", n, gametic, leveltime, (int)paused);
+    return n;
+}
+
+// move the player (test only): Module._fm1_web_warp(x, y) in map units
+int fm1_web_warp(int x, int y) { return gamestate == GS_LEVEL && players[0].mo ? P_TeleportMove(players[0].mo, x << 16, y << 16) : -1; }
+// how many monsters have left their idle states, and the player's health
+int fm1_web_awake(void)
+{
+    int awake = 0;
+    if (gamestate != GS_LEVEL)
+        return -1;
+    for (thinker_t *t = thinker_next(&thinkercap); t != &thinkercap; t = thinker_next(t))
+        if (t->function == ThinkF_P_MobjThinker && (((mobj_t *)t)->flags & MF_COUNTKILL)) {
+            int st = (int)mobj_state_num((mobj_t *)t), sp = mobj_info((mobj_t *)t)->spawnstate;
+            awake += st != sp && st != sp + 1;
+        }
+    return awake * 1000 + players[0].health;
+}
