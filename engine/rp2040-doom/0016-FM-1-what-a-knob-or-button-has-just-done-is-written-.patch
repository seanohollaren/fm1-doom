--- /dev/null
+++ b/src/fm1/fm1_osd.h
@@ -0,0 +1,159 @@
+// FM-1: the message line, drawn large. What a knob or button has just done ("LOW PASS 955 HZ",
+// "MUSIC 20 CHURCH ORGAN") is written across the top of the picture at the panel's own resolution, about twice the
+// size of the game's own message font as the panel shows it: capitals 5 dots by 7, each dot 2 by 2 pixels, in
+// lines of 20 characters on a darkened band, for three seconds. fm1_video.c draws it into each panel row as it
+// goes out; fm1_controls.c says what to write. The game's own messages ("PICKED UP A CLIP") are not touched.
+// The letters were drawn for this file. firmware/tests/osd_test.c in the fm1-doom repository tests it on a PC.
+//
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <stdint.h>
+
+#define FM1_OSD_COLS 20                 // characters a line
+#define FM1_OSD_LINES 3
+#define FM1_OSD_CELL_W 12               // a character's pixels: 5 dots and a gap, twice over
+#define FM1_OSD_LINE_H 18               // 7 dots twice over, and 4 pixels to the next line
+#define FM1_OSD_PAD 4                   // band above the first line and below the last
+#define FM1_OSD_MS 3000u                // how long a message stays
+
+// the dots of characters 32 (space) to 95, seven rows each, the leftmost dot in bit 4
+static const uint8_t FM1_OSD_FONT[64][7] = {
+    {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00},   //  
+    {0x04, 0x04, 0x04, 0x04, 0x04, 0x00, 0x04},   // !
+    {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00},   // "
+    {0x0A, 0x0A, 0x1F, 0x0A, 0x1F, 0x0A, 0x0A},   // #
+    {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00},   // $
+    {0x18, 0x19, 0x02, 0x04, 0x08, 0x13, 0x03},   // %
+    {0x0C, 0x12, 0x14, 0x08, 0x15, 0x12, 0x0D},   // &
+    {0x04, 0x04, 0x08, 0x00, 0x00, 0x00, 0x00},   // '
+    {0x02, 0x04, 0x08, 0x08, 0x08, 0x04, 0x02},   // (
+    {0x08, 0x04, 0x02, 0x02, 0x02, 0x04, 0x08},   // )
+    {0x00, 0x15, 0x0E, 0x1F, 0x0E, 0x15, 0x00},   // *
+    {0x00, 0x04, 0x04, 0x1F, 0x04, 0x04, 0x00},   // +
+    {0x00, 0x00, 0x00, 0x00, 0x0C, 0x04, 0x08},   // ,
+    {0x00, 0x00, 0x00, 0x1F, 0x00, 0x00, 0x00},   // -
+    {0x00, 0x00, 0x00, 0x00, 0x00, 0x0C, 0x0C},   // .
+    {0x01, 0x01, 0x02, 0x04, 0x08, 0x10, 0x10},   // /
+    {0x0E, 0x11, 0x13, 0x15, 0x19, 0x11, 0x0E},   // 0
+    {0x04, 0x0C, 0x04, 0x04, 0x04, 0x04, 0x0E},   // 1
+    {0x0E, 0x11, 0x01, 0x06, 0x08, 0x10, 0x1F},   // 2
+    {0x1E, 0x01, 0x01, 0x0E, 0x01, 0x01, 0x1E},   // 3
+    {0x02, 0x06, 0x0A, 0x12, 0x1F, 0x02, 0x02},   // 4
+    {0x1F, 0x10, 0x1E, 0x01, 0x01, 0x11, 0x0E},   // 5
+    {0x06, 0x08, 0x10, 0x1E, 0x11, 0x11, 0x0E},   // 6
+    {0x1F, 0x01, 0x02, 0x04, 0x08, 0x08, 0x08},   // 7
+    {0x0E, 0x11, 0x11, 0x0E, 0x11, 0x11, 0x0E},   // 8
+    {0x0E, 0x11, 0x11, 0x0F, 0x01, 0x02, 0x0C},   // 9
+    {0x00, 0x0C, 0x0C, 0x00, 0x0C, 0x0C, 0x00},   // :
+    {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00},   // ;
+    {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00},   // <
+    {0x00, 0x00, 0x1F, 0x00, 0x1F, 0x00, 0x00},   // =
+    {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00},   // >
+    {0x0E, 0x11, 0x01, 0x02, 0x04, 0x00, 0x04},   // ?
+    {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00},   // @
+    {0x0E, 0x11, 0x11, 0x1F, 0x11, 0x11, 0x11},   // A
+    {0x1E, 0x11, 0x11, 0x1E, 0x11, 0x11, 0x1E},   // B
+    {0x0E, 0x11, 0x10, 0x10, 0x10, 0x11, 0x0E},   // C
+    {0x1E, 0x11, 0x11, 0x11, 0x11, 0x11, 0x1E},   // D
+    {0x1F, 0x10, 0x10, 0x1E, 0x10, 0x10, 0x1F},   // E
+    {0x1F, 0x10, 0x10, 0x1E, 0x10, 0x10, 0x10},   // F
+    {0x0E, 0x11, 0x10, 0x17, 0x11, 0x11, 0x0F},   // G
+    {0x11, 0x11, 0x11, 0x1F, 0x11, 0x11, 0x11},   // H
+    {0x0E, 0x04, 0x04, 0x04, 0x04, 0x04, 0x0E},   // I
+    {0x07, 0x02, 0x02, 0x02, 0x02, 0x12, 0x0C},   // J
+    {0x11, 0x12, 0x14, 0x18, 0x14, 0x12, 0x11},   // K
+    {0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x1F},   // L
+    {0x11, 0x1B, 0x15, 0x15, 0x11, 0x11, 0x11},   // M
+    {0x11, 0x19, 0x15, 0x13, 0x11, 0x11, 0x11},   // N
+    {0x0E, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0E},   // O
+    {0x1E, 0x11, 0x11, 0x1E, 0x10, 0x10, 0x10},   // P
+    {0x0E, 0x11, 0x11, 0x11, 0x15, 0x12, 0x0D},   // Q
+    {0x1E, 0x11, 0x11, 0x1E, 0x14, 0x12, 0x11},   // R
+    {0x0F, 0x10, 0x10, 0x0E, 0x01, 0x01, 0x1E},   // S
+    {0x1F, 0x04, 0x04, 0x04, 0x04, 0x04, 0x04},   // T
+    {0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0E},   // U
+    {0x11, 0x11, 0x11, 0x11, 0x11, 0x0A, 0x04},   // V
+    {0x11, 0x11, 0x11, 0x15, 0x15, 0x1B, 0x11},   // W
+    {0x11, 0x11, 0x0A, 0x04, 0x0A, 0x11, 0x11},   // X
+    {0x11, 0x11, 0x0A, 0x04, 0x04, 0x04, 0x04},   // Y
+    {0x1F, 0x01, 0x02, 0x04, 0x08, 0x10, 0x1F},   // Z
+    {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00},   // [
+    {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00},   // backslash
+    {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00},   // ]
+    {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00},   // ^
+    {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00},   // _
+};
+
+typedef struct {
+    char text[FM1_OSD_LINES][FM1_OSD_COLS + 1];
+    uint8_t lines;                      // 0: nothing to show
+    uint32_t until;                     // on the millisecond clock
+} fm1_osd_t;
+
+// Take a message: capitals, broken into lines at its spaces (a word longer than a line is cut; what does not fit
+// in the lines there are is dropped).
+static void fm1_osd_set(fm1_osd_t *o, const char *s, uint32_t now)
+{
+    int line = 0, col = 0;
+    while (*s == ' ')
+        s++;
+    while (*s && line < FM1_OSD_LINES) {
+        int n = 0, i;
+        while (s[n] && s[n] != ' ')
+            n++;
+        if (col && col + 1 + n > FM1_OSD_COLS) {            // the word goes on the next line
+            o->text[line++][col] = 0;
+            col = 0;
+            continue;
+        }
+        if (col)
+            o->text[line][col++] = ' ';
+        for (i = 0; i < n && col < FM1_OSD_COLS; i++) {
+            char c = s[i];
+            o->text[line][col++] = (char)(c >= 'a' && c <= 'z' ? c - 32 : c);
+        }
+        s += n;
+        while (*s == ' ')
+            s++;
+    }
+    if (line < FM1_OSD_LINES)
+        o->text[line++][col] = 0;
+    o->lines = (uint8_t)(col || line > 1 ? line : 0);
+    o->until = now + FM1_OSD_MS;
+}
+
+static inline int fm1_osd_on(const fm1_osd_t *o, uint32_t now) { return o->lines && (int32_t)(o->until - now) > 0; }
+// how many panel rows the band takes from its top
+static inline int fm1_osd_height(const fm1_osd_t *o) { return 2 * FM1_OSD_PAD + o->lines * FM1_OSD_LINE_H - 4; }
+
+// One panel row of `width` pixels (RGB565 with its two bytes swapped, as the panel takes them), `y` rows below
+// the top of the band: the picture is dimmed to a quarter, and the row's dots are written in white.
+static void fm1_osd_row(const fm1_osd_t *o, uint16_t *px, int width, int y)
+{
+    int i, r, line, dot;
+    const char *t;
+    if (y < 0 || y >= fm1_osd_height(o))
+        return;
+    for (i = 0; i < width; i++) {
+        uint16_t v = (uint16_t)(px[i] << 8 | px[i] >> 8);
+        v = (uint16_t)((v >> 2) & 0x39E7u);
+        px[i] = (uint16_t)(v << 8 | v >> 8);
+    }
+    r = y - FM1_OSD_PAD;
+    if (r < 0)
+        return;
+    line = r / FM1_OSD_LINE_H;
+    dot = r % FM1_OSD_LINE_H / 2;
+    if (line >= o->lines || dot >= 7)
+        return;
+    t = o->text[line];
+    for (i = 0; t[i]; i++)
+        ;
+    px += (width - (i * FM1_OSD_CELL_W - 2)) / 2;           // the line centred
+    for (; *t; t++, px += FM1_OSD_CELL_W) {
+        unsigned c = (unsigned char)*t - 32u, bits = c < 64u ? FM1_OSD_FONT[c][dot] : 0u;
+        for (i = 0; bits; i += 2, bits = (bits << 1) & 0x1Fu)
+            if (bits & 0x10u)
+                px[i] = px[i + 1] = 0xFFFFu;
+    }
+}
