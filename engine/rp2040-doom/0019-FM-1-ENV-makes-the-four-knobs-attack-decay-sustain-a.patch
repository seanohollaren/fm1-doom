     }
-    if (enc[FM1_ENC_K4] && !fm1_page) {
+    if (enc[FM1_ENC_K4] && fm1_page == FM1_PAGE_MAIN) {
         fm1_tempo = (int8_t)fm1_turn(fm1_tempo, enc[FM1_ENC_K4], -FM1_TEMPO_STEPS, FM1_TEMPO_STEPS);
         fm1_music_time = 6553600u / FM1_TEMPO[fm1_tempo + FM1_TEMPO_STEPS];
         fm1_say("TEMPO ", FM1_TEMPO[fm1_tempo + FM1_TEMPO_STEPS], "%");
     }
-    if (enc[FM1_ENC_K3] && fm1_page) {
-        int e = fm1_turn(fm1_music_env, enc[FM1_ENC_K3], -FM1_ENV_STEPS, FM1_ENV_STEPS);
-        fm1_music_env = (int8_t)e;
-        FM1_Reshape();
-        if (e)
-            fm1_say(e < 0 ? "ENVELOPE SHORT " : "ENVELOPE LONG ", e < 0 ? -e : e, "");
-        else
-            fm1_say("ENVELOPE AS WRITTEN", -1, "");
+    // after ENV: the four knobs are attack, decay, sustain, release
+    for (unsigned i = 0; i < 4u && fm1_page == FM1_PAGE_ENV; i++) {
+        if (enc[FM1_ENC_K1 + i]) {
+            int n = fm1_turn(fm1_music_adsr[i], enc[FM1_ENC_K1 + i], 0, FM1_ADSR_STEPS[i]);
+            fm1_music_adsr[i] = (uint8_t)n;
+            FM1_Reshape();
+            if (n)
+                fm1_say(FM1_ADSR_NAMES[i], n, "");
+            else
+                fm1_say("ORIGINAL ", -1, FM1_ADSR_NAMES[i]);
+        }
     }
-    if (enc[FM1_ENC_K4] && fm1_page) {
-        int w = fm1_turn(fm1_filter_wobble, enc[FM1_ENC_K4], 0, FM1_WOBBLE_STEPS);
+    // after LFO: KNOB 1 is the wobble
+    if (enc[FM1_ENC_K1] && fm1_page == FM1_PAGE_LFO) {
+        int w = fm1_turn(fm1_filter_wobble, enc[FM1_ENC_K1], 0, FM1_WOBBLE_STEPS);
         fm1_filter_wobble = (int8_t)w;
         if (w) {
             fm1_say("WOBBLE ", -1, FM1_WOBBLE_HZ[w - 1]);
-            fm1_say_more(fm1_filter_pos ? " HZ" : " HZ: TURN KNOB 1 TOO");     /* nothing to wobble while the filter is off */
+            fm1_say_more(fm1_filter_pos ? " HZ" : " HZ: NEEDS THE FILTER ON");     /* nothing to wobble while the filter is off */
         } else
