@@ -173,7 +186,7 @@ void fm1_controls_update(uint32_t notes, uint32_t buttons, const int8_t enc[FM1_
         else
             fm1_say(pos < 0 ? "LOW PASS " : "HIGH PASS ", FM1_FILTER_HZ[fm1_filter_step(pos)], " HZ");
     }
-    if (enc[FM1_ENC_K2]) {
+    if (enc[FM1_ENC_K2] && fm1_page == FM1_PAGE_MAIN) {
         int res = fm1_filter_res + enc[FM1_ENC_K2];
         if (res < 0) res = 0;
         if (res >= FM1_FILTER_RES) res = FM1_FILTER_RES - 1;
@@ -196,36 +209,36 @@ void fm1_controls_update(uint32_t notes, uint32_t buttons, const int8_t enc[FM1_
         FM1_Reshape();
         fm1_say_signed("FM DEPTH", fm1_music_depth);
     }
-    // KNOB 3 and KNOB 4: pitch and tempo, or (after ENV) envelope and wobble
-    if (pressed & (1u << FM1_BTN_ENV)) {
-        fm1_page ^= 1u;
-        fm1_say("KNOBS 3 AND 4: ", -1, fm1_page ? "ENVELOPE, WOBBLE" : "PITCH, TEMPO");
-    }
-    if (enc[FM1_ENC_K3] && !fm1_page) {
+    // KNOB 3 pitch, KNOB 4 tempo
