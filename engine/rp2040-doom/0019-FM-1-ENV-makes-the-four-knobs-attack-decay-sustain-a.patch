 #define FM1_DEPTH_STEPS 8                                    /* 1.5 dB of modulation each */
-#define FM1_ENV_STEPS 6
+static const uint8_t FM1_ADSR_STEPS[4] = {6, 8, 10, 8};     /* attack, decay, sustain, release (i_oplmusic.c has what a step is) */
