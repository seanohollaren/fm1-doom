diff --git a/src/i_oplmusic.c b/src/i_oplmusic.c
index 5ce5ebf..f5154d3 100644
--- a/src/i_oplmusic.c
+++ b/src/i_oplmusic.c
@@ -349,11 +349,11 @@ static char (*percussion_names)[32];
 //   fm1_music_pitch  semitones added to every melodic note (FM1_Retune moves the notes sounding now)
 //   fm1_music_time   how long a beat lasts, 65536 = as written
 //   fm1_music_depth  FM depth: each step turns the modulator of an FM voice up (+) or down (-) by 1.5 dB
-//   fm1_music_env    the envelope of what is heard: each step up, a slower attack and a release twice as long;
-//                    each step down, notes that die away by themselves, twice as fast (FM1_Reshape applies
-//                    this and the depth to every voice at once)
-extern volatile uint8_t fm1_music_instr;
-extern volatile int8_t fm1_music_pitch, fm1_music_depth, fm1_music_env;
+//   fm1_music_adsr   the envelope of what is heard: attack, decay, sustain, release. 0: the instrument's own;
+//                    n: a longer attack, decay or release, or a higher sustain level, the higher n is
+//                    (FM1_ShapeVoice has the numbers; FM1_Reshape applies these and the depth to every voice)
+extern volatile uint8_t fm1_music_instr, fm1_music_adsr[4];
+extern volatile int8_t fm1_music_pitch, fm1_music_depth;
 extern volatile uint32_t fm1_music_time;
 const char *fm1_music_instr_name(int n)
 {
@@ -372,8 +372,10 @@ static int voice_alloced_num;
 // (browser build, test hook) what the i-th sounding voice is doing, -1 when there is none.
 // what 0: its instrument, 0..127 melodic, 128 up percussion; 1: its frequency register (octave << 10 | number);
 // 2: its modulator's level, 0 loudest .. 63; 4: its note as written, before the pitch knob.
-// what 3: how many of the music's ticks have been played so far.
+// what 3: how many of the music's ticks have been played so far.  what 5, 6, 7: the envelope last written by the
+// envelope knobs (flags, attack << 4 | decay, sustain << 4 | release).
 static unsigned int fm1_music_ticks;
+static int fm1_shape_log[3];
 int fm1_music_probe(int what, int i)
 {
     opl_voice_t *voice;
@@ -382,6 +384,10 @@ int fm1_music_probe(int what, int i)
     {
         return (int) fm1_music_ticks;
     }
+    if (what >= 5 && what <= 7)
+    {
+        return fm1_shape_log[what - 5];
+    }
     if (i < 0 || i >= voice_alloced_num)
     {
         return -1;
@@ -566,18 +572,28 @@ static void LoadOperatorData(int operator, genmidi_op_t *data,
 // FM-1: the depth and envelope knobs, written over what LoadOperatorData put in a voice's registers
 // (with both knobs at rest this writes the instrument's own values back).
 
-#define FM1_ENV_ATTACK  7       // "long" step 1 caps the attack rate at 6, step 6 at 1
-#define FM1_ENV_RELEASE 9       // ... and the release rate at 8 (a third of a second) down to 3 (ten seconds)
+// The four envelope knobs give rates and a level in the chip's own terms. A rate is 0 (never) to 15 (at once),
+// each twice as fast as the one below; an instrument that scales its rates with pitch still does, and E1M1's
+// guitars do, which makes them a step or two faster than the figures here. The knobs cover the rates that can be
+// told apart by ear in music (measured on E1M1; anything faster is a click, as the first single knob showed):
+//   attack   rate 6 (about 90 ms) at the first step down to 1 (about 3 s) at the sixth
+//   decay    rate 8 (a pluck: 20 dB down in about 60 ms) down to 1 (hardly falling at all) at the eighth
+//   sustain  the level the note falls to and holds: silence, then 30 dB down, rising to full at the tenth
+//   release  rate 9 (gone in a fraction of a second) down to 2 (ringing on for many seconds) at the eighth
+#define FM1_ATTACK_RATE(n)   (7 - (n))
+#define FM1_DECAY_RATE(n)    (9 - (n))
+#define FM1_RELEASE_RATE(n)  (10 - (n))
+static const unsigned char fm1_sustain_level[10] = {15, 10, 8, 6, 5, 4, 3, 2, 1, 0};   // 3 dB a unit; 15 is silence
+#define FM1_SUSTAIN_DECAY    6              // the decay a sustain setting gets on an instrument that has none
 
 static void FM1_ShapeVoice(opl_voice_t *voice)
 {
     genmidi_voice_t *data;
     genmidi_op_t *op;
-    int fm, env, i, n, reg, attack, decay, level, release;
+    int fm, i, n, reg, flags, attack, decay, level, release;
 
     data = &voice->current_instr->voices[voice->current_instr_voice];
     fm = (data->feedback & 0x01) == 0;
-    env = fm1_music_env;
 
     // The modulator's level sets how far it bends the carrier's wave:
     // 0 is the most, 63 none, three quarters of a decibel a step.
@@ -598,44 +614,45 @@ static void FM1_ShapeVoice(opl_voice_t *voice)
     {
         op = i ? &data->carrier : &data->modulator;
         reg = (i ? voice->op2 : voice->op1) | voice->array;
+        flags = op->tremolo;
         attack = op->attack >> 4;
         decay = op->attack & 0x0f;
         level = op->sustain >> 4;
         release = op->sustain & 0x0f;
 
-        // Every rate is twice as fast as the one below it.
-
-        if (env > 0)
+        if (fm1_music_adsr[0])
         {
-            // long: the attack no faster than FM1_ENV_ATTACK - env, and the
-            // release no faster than FM1_ENV_RELEASE - env
-            if (attack > FM1_ENV_ATTACK - env)
-            {
-                attack = FM1_ENV_ATTACK - env;
-            }
-            if (release > FM1_ENV_RELEASE - env)
-            {
-                release = FM1_ENV_RELEASE - env;
-            }
+            attack = FM1_ATTACK_RATE(fm1_music_adsr[0]);
         }
-        else if (env < 0)
+        if (fm1_music_adsr[1])
         {
-            // short: the note falls away to nothing while the key is still
-            // down, at rate 7 (about half a second) at the first step up to
-            // 12 (a few hundredths) at the last, and is let go no slower
-            level = 0x0f;
-            if (decay < 6 - env)
-            {
-                decay = 6 - env;
-            }
-            if (release < 6 - env)
+            decay = FM1_DECAY_RATE(fm1_music_adsr[1]);
+        }
+        if (fm1_music_adsr[2])
+        {
+            // The note falls to this level and is held there while the
+            // key is down. An instrument that never falls (several of the
+            // guitars) is given a decay, or the knob would do nothing.
+            level = fm1_sustain_level[fm1_music_adsr[2] - 1];
+            flags |= 0x20;
+            if (decay == 0)
             {
-                release = 6 - env;
+                decay = FM1_SUSTAIN_DECAY;
             }
         }
+        if (fm1_music_adsr[3])
+        {
+            release = FM1_RELEASE_RATE(fm1_music_adsr[3]);
+        }
 
+        OPL_WriteRegister(OPL_REGS_TREMOLO + reg, flags);
         OPL_WriteRegister(OPL_REGS_ATTACK + reg, (attack << 4) | decay);
         OPL_WriteRegister(OPL_REGS_SUSTAIN + reg, (level << 4) | release);
+#if FM1_WEB
+        fm1_shape_log[0] = flags;
+        fm1_shape_log[1] = (attack << 4) | decay;
+        fm1_shape_log[2] = (level << 4) | release;
+#endif
     }
 }
 #endif
@@ -684,7 +701,8 @@ static void SetVoiceInstrument(opl_voice_t *voice,
                       data->feedback | voice->reg_pan);
 
 #if FM1
-    if (fm1_music_depth || fm1_music_env)
+    if (fm1_music_depth || fm1_music_adsr[0] || fm1_music_adsr[1]
+     || fm1_music_adsr[2] || fm1_music_adsr[3])
     {
         FM1_ShapeVoice(voice);
     }
