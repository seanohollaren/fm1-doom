@@ -160,8 +164,17 @@ void fm1_controls_update(uint32_t notes, uint32_t buttons, const int8_t enc[FM1_
             fm1_down[k >> 3] ^= (uint8_t)m;
         }
     }
+    // ENV and LFO: the four knobs' other jobs, and back
+    if (pressed & (1u << FM1_BTN_ENV)) {
+        fm1_page = fm1_page == FM1_PAGE_ENV ? FM1_PAGE_MAIN : FM1_PAGE_ENV;
+        fm1_say("KNOBS: ", -1, fm1_page ? "ENVELOPE" : "FILTER, PITCH, TEMPO");
