-        fm1_music_pitch = fm1_music_depth = fm1_music_env = 0;
+        fm1_music_pitch = fm1_music_depth = 0;
+        fm1_music_adsr[0] = fm1_music_adsr[1] = fm1_music_adsr[2] = fm1_music_adsr[3] = 0;
