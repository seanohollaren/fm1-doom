 // knobs on the music (i_oplmusic.c, which says what each value means): the instrument it is played on, its
-// pitch, how long its beats last, the depth of its FM and its envelope. After a change of pitch the sounding
+// pitch, how long its beats last, the depth of its FM and its envelope (attack, decay, sustain, release). After a change of pitch the sounding
 // notes are moved with FM1_Retune; after a change of depth or envelope every voice is rewritten with FM1_Reshape.
 #define FM1_MUSIC_INSTRS 128
-extern volatile uint8_t fm1_music_instr;
-extern volatile int8_t fm1_music_pitch, fm1_music_depth, fm1_music_env;
