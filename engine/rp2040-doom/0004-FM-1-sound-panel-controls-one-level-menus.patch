diff --git a/src/fm1/fm1_audio.c b/src/fm1/fm1_audio.c
new file mode 100644
index 0000000..df2ed34
--- /dev/null
+++ b/src/fm1/fm1_audio.c
@@ -0,0 +1,95 @@
+//
+// FM-1 audio: the mixer (src/pico/i_picosound.c) and the OPL music (opl/opl_pico.c) produce 16-bit stereo at
+// 49,716 Hz (the OPL chip's own rate) through pico-extras' "audio buffer" calls. Here those calls fill a ring
+// buffer from the main loop, and the output side (an audio interrupt on the device, the page in the browser)
+// pulls from it with fm1_audio_read(), which resamples to whatever rate the output runs at.
+//
+#include <string.h>
+#include "pico.h"
+#include "pico/audio_i2s.h"
+#include "i_sound.h"
+#include "fm1.h"
+
+#define FM1_AUDIO_RATE 49716u
+#define FM1_BUF_FRAMES 512u               /* one mixer pass */
+#define FM1_RING_FRAMES 4096u             /* power of 2: 82 ms */
+
+static int16_t fm1_mix[FM1_BUF_FRAMES * 2];
+static mem_buffer_t fm1_mem = { sizeof fm1_mix, (uint8_t *)fm1_mix, 0 };
+static audio_buffer_t fm1_buf;
+static int16_t fm1_ring[FM1_RING_FRAMES * 2];
+static volatile uint32_t fm1_w, fm1_r;    /* frame counters; the reader only moves fm1_r, the writer only fm1_w */
+static uint32_t fm1_phase;                /* resampler position between frame fm1_r and fm1_r + 1, 16.16 */
+static uint8_t fm1_audio_on;
+uint32_t fm1_audio_underruns;
+
+audio_buffer_pool_t *audio_new_producer_pool(audio_buffer_format_t *format, int buffer_count, int buffer_sample_count)
+{
+    (void)buffer_count; (void)buffer_sample_count;
+    fm1_buf.buffer = &fm1_mem;
+    fm1_buf.format = format;
+    fm1_buf.max_sample_count = FM1_BUF_FRAMES;
+    return (audio_buffer_pool_t *)&fm1_buf;
+}
+
+audio_buffer_t *take_audio_buffer(audio_buffer_pool_t *ac, bool block)
+{
+    (void)ac; (void)block;
+    if (FM1_RING_FRAMES - (fm1_w - fm1_r) < FM1_BUF_FRAMES + 2u)
+        return NULL;                      /* no room yet: the mixer skips this pass */
+    return &fm1_buf;
+}
+
+void give_audio_buffer(audio_buffer_pool_t *ac, audio_buffer_t *buffer)
+{
+    (void)ac;
+    for (uint32_t i = 0; i < buffer->sample_count; i++) {
+        uint32_t k = (fm1_w + i) & (FM1_RING_FRAMES - 1u);
+        fm1_ring[2u * k] = fm1_mix[2u * i];
+        fm1_ring[2u * k + 1u] = fm1_mix[2u * i + 1u];
+    }
+    fm1_w += buffer->sample_count;        /* published last */
+}
+
+const audio_format_t *audio_i2s_setup(const audio_format_t *intended_audio_format, const audio_i2s_config_t *config)
+{
+    (void)config;
+    return intended_audio_format;
+}
+bool audio_i2s_connect_extra(audio_buffer_pool_t *producer, bool buffer_on_give, uint buffer_count,
+                             uint samples_per_buffer, audio_connection_t *connection)
+{
+    (void)producer; (void)buffer_on_give; (void)buffer_count; (void)samples_per_buffer; (void)connection;
+    return true;
+}
+void audio_i2s_set_enabled(bool enabled) { fm1_audio_on = enabled; }
+
+// Fill the ring as far as it goes. The RP2040 version leans on its second core to call I_UpdateSound often;
+// with one core it is called once per shown frame from here (fm1_video.c) and in the engine's own wait loops.
+void fm1_audio_pump(void)
+{
+    for (int i = 0; i < 8 && FM1_RING_FRAMES - (fm1_w - fm1_r) >= FM1_BUF_FRAMES + 2u; i++)
+        I_UpdateSound();
+}
+
+// Output side: frames of 16-bit stereo at out_rate (linear interpolation from 49,716 Hz). Silence on underrun.
+void fm1_audio_read(int16_t *dst, uint32_t frames, uint32_t out_rate)
+{
+    uint32_t step = (uint32_t)(((uint64_t)FM1_AUDIO_RATE << 16) / out_rate);
+    for (uint32_t i = 0; i < frames; i++) {
+        if (!fm1_audio_on || fm1_w - fm1_r < 2u) {
+            dst[2u * i] = dst[2u * i + 1u] = 0;
+            if (fm1_audio_on)
+                fm1_audio_underruns++;
+            continue;
+        }
+        const int16_t *a = &fm1_ring[2u * (fm1_r & (FM1_RING_FRAMES - 1u))];
+        const int16_t *b = &fm1_ring[2u * ((fm1_r + 1u) & (FM1_RING_FRAMES - 1u))];
+        int32_t f = (int32_t)(fm1_phase >> 1);                           /* 0..32767 */
+        dst[2u * i] = (int16_t)(a[0] + (((b[0] - a[0]) * f) >> 15));
+        dst[2u * i + 1u] = (int16_t)(a[1] + (((b[1] - a[1]) * f) >> 15));
+        fm1_phase += step;
+        fm1_r += fm1_phase >> 16;
+        fm1_phase &= 0xFFFFu;
+    }
+}
diff --git a/src/fm1/fm1_controls.c b/src/fm1/fm1_controls.c
new file mode 100644
index 0000000..9473bfa
--- /dev/null
+++ b/src/fm1/fm1_controls.c
@@ -0,0 +1,89 @@
+//
+// FM-1 controls: the panel (27 note keys F3..G5, 14 buttons, 7 encoders) -> Doom key events.
+// The platform reports the panel as Felucca's HAL does (bit n of notes = key n, bit n of buttons = the button
+// with that printed label, encoder steps since the last poll, + = clockwise); this file owns the layout.
+//
+//   left hand, around the low A:      G#3 / A#3 forward     F#3 run
+//                                 G3 turn left   A3 back   B3 turn right        F3 / C4 strafe left / right
+//   right hand, top of the keyboard:  E5 / F5 fire          D5 / G5 use (open doors)   F#5 run
+//   buttons:  HOME menu (Esc)   PLAY select (Enter)   REC fire   OCT- / OCT+ previous / next weapon   FX yes
+//   knobs:    SELECT moves through menus (weapons while playing)   KNOB 4 previous / next weapon
+//
+#include "doomkeys.h"
+#include "doomtype.h"
+#include "m_controls.h"
+extern boolean menuactive;                                   /* doom/m_menu.c */
+#include "fm1.h"
+
+#define FM1_KEY_PREVWEAPON '['
+#define FM1_KEY_NEXTWEAPON ']'
+
+typedef struct { uint8_t src; uint8_t key; } fm1_map_t;       /* src: 0..26 note key, 32 + label = button */
+#define BTN(label) (32 + (label))
+static const fm1_map_t FM1_MAP[] = {
+    {3, KEY_UPARROW}, {5, KEY_UPARROW}, {2, KEY_LEFTARROW}, {4, KEY_DOWNARROW}, {6, KEY_RIGHTARROW},
+    {0, ','}, {7, '.'}, {1, KEY_RSHIFT}, {25, KEY_RSHIFT},
+    {23, KEY_RCTRL}, {24, KEY_RCTRL}, {21, ' '}, {26, ' '},
+    {BTN(FM1_BTN_HOME), KEY_ESCAPE}, {BTN(FM1_BTN_PLAY), KEY_ENTER}, {BTN(FM1_BTN_REC), KEY_RCTRL},
+    {BTN(FM1_BTN_OCTDN), FM1_KEY_PREVWEAPON}, {BTN(FM1_BTN_OCTUP), FM1_KEY_NEXTWEAPON}, {BTN(FM1_BTN_FX), 'y'},
+};
+#define FM1_NMAP (sizeof FM1_MAP / sizeof FM1_MAP[0])
+
+static uint8_t fm1_down[256 / 8];                             /* Doom keys currently held */
+static struct { uint8_t key, down; } fm1_q[64];
+static unsigned fm1_qr, fm1_qw;
+
+static void fm1_push(int key, int down)
+{
+    if (fm1_qw - fm1_qr >= 64u)
+        return;                                               /* full: drop (the state is re-derived next poll) */
+    fm1_q[fm1_qw & 63u].key = (uint8_t)key;
+    fm1_q[fm1_qw++ & 63u].down = (uint8_t)down;
+}
+
+static void fm1_tap(int key, int times)
+{
+    while (times-- > 0) {
+        fm1_push(key, 1);
+        fm1_push(key, 0);
+    }
+}
+
+void fm1_controls_init(void)
+{
+    key_prevweapon = FM1_KEY_PREVWEAPON;
+    key_nextweapon = FM1_KEY_NEXTWEAPON;
+}
+
+void fm1_controls_update(uint32_t notes, uint32_t buttons, const int8_t enc[FM1_NENC])
+{
+    uint8_t want[256 / 8] = {0};
+    for (unsigned i = 0; i < FM1_NMAP; i++) {
+        unsigned s = FM1_MAP[i].src;
+        if (s < 32u ? (notes >> s) & 1u : (buttons >> (s - 32u)) & 1u)
+            want[FM1_MAP[i].key >> 3] |= (uint8_t)(1u << (FM1_MAP[i].key & 7u));
+    }
+    for (unsigned i = 0; i < FM1_NMAP; i++) {                 /* each mapped key once per change */
+        unsigned k = FM1_MAP[i].key, m = 1u << (k & 7u);
+        if ((want[k >> 3] ^ fm1_down[k >> 3]) & m) {
+            fm1_push((int)k, (want[k >> 3] & m) != 0);
+            fm1_down[k >> 3] ^= (uint8_t)m;
+        }
+    }
+    int sel = enc[FM1_ENC_SELECT], k4 = enc[FM1_ENC_K4];
+    if (menuactive) {
+        fm1_tap(sel > 0 ? KEY_DOWNARROW : KEY_UPARROW, sel > 0 ? sel : -sel);
+    } else {
+        k4 += sel;
+    }
+    fm1_tap(k4 > 0 ? FM1_KEY_NEXTWEAPON : FM1_KEY_PREVWEAPON, k4 > 0 ? k4 : -k4);
+}
+
+int fm1_next_key(int *doom_key, int *down)
+{
+    if (fm1_qr == fm1_qw)
+        return 0;
+    *doom_key = fm1_q[fm1_qr & 63u].key;
+    *down = fm1_q[fm1_qr++ & 63u].down;
+    return 1;
+}
