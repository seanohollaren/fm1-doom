diff --git a/src/fm1/fm1_platform.c b/src/fm1/fm1_platform.c
new file mode 100644
index 0000000..7b90c39
--- /dev/null
+++ b/src/fm1/fm1_platform.c
@@ -0,0 +1,198 @@
+//
+// FM-1 platform layer for the tiny Doom build: everything src/pico/* provided on the RP2040 except video
+// (fm1_video.c). One CPU core: the semaphores the two-core design waits on run "the other core's" work
+// inline instead of blocking. No sound yet (the sound and OPL drivers report "not available").
+//
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdarg.h>
+#include <string.h>
+#include "pico.h"
+#include "pico/sem.h"
+#include "config.h"
+#include "doomtype.h"
+#include "doomkeys.h"
+#include "d_event.h"
+#include "i_input.h"
+#include "i_sound.h"
+#include "i_system.h"
+#include "i_timer.h"
+#include "i_video.h"
+#include "m_misc.h"
+#include "z_zone.h"
+#include "picodoom.h"
+#include "piconet.h"
+#include "doom/p_saveg.h"
+#include "opl_internal.h"
+#include "fm1.h"
+
+unsigned char *fm1_shortptr_base;
+extern const uint8_t *whd_map_base;
+extern semaphore_t render_frame_ready, display_frame_freed;
+void D_DoomMain(void);
+
+// ------------------------------------------------------------------ one core
+static uint8_t fm1_other_busy;
+
+static void fm1_other_core(void)
+{
+    if (fm1_other_busy)
+        return;
+    fm1_other_busy = 1;
+    if (render_frame_ready.permits > 0)
+        fm1_present();                   // "core 1" shows the finished frame, freeing a frame buffer
+    else
+        pd_core1_loop();                 // "core 1" has no drawing of its own here: it just answers core 0
+    fm1_other_busy = 0;
+}
+
+void sem_init(semaphore_t *sem, int16_t initial_permits, int16_t max_permits)
+{
+    sem->permits = initial_permits;
+    sem->max_permits = max_permits;
+}
+
+int sem_available(semaphore_t *sem)
+{
+    if (sem == &display_frame_freed && sem->permits <= 0)
+        fm1_other_core();
+    return sem->permits;
+}
+
+bool sem_release(semaphore_t *sem)
+{
+    if (sem->permits >= sem->max_permits)
+        return false;
+    sem->permits++;
+    return true;
+}
+
+void sem_acquire_blocking(semaphore_t *sem)
+{
+    int tries = 0;
+    while (sem->permits <= 0) {
+        fm1_other_core();
+        if (++tries > 8)
+            panic("fm1: semaphore would block for ever");
+    }
+    sem->permits--;
+}
+
+bool sem_acquire_timeout_ms(semaphore_t *sem, uint32_t timeout_ms)
+{
+    (void)timeout_ms;
+    if (sem->permits <= 0)
+        return false;
+    sem->permits--;
+    return true;
+}
+
+// ------------------------------------------------------------------ time
+uint32_t time_us_32(void) { return fm1_millis() * 1000u; }
+int I_GetTime(void) { return (int)(((uint64_t)fm1_millis() * TICRATE) / 1000u); }
+int I_GetTimeMS(void) { return (int)fm1_millis(); }
+void I_Sleep(int ms)
+{
+    uint32_t t0 = fm1_millis();
+    while (fm1_millis() - t0 < (uint32_t)ms)
+        ;
+}
+void I_WaitVBL(int count) { I_Sleep((count * 1000) / 70); }
+void I_InitTimer(void) {}
+
+// ------------------------------------------------------------------ memory
+byte *I_ZoneBase(int *size)
+{
+    uint32_t n;
+    uint8_t *heap = fm1_heap(&n);
+    *size = (int)n;
+    return heap;
+}
+
+void *fm1_malloc(size_t size) { return Z_MallocNoUser((int)size, PU_STATIC); }
+void *fm1_calloc(size_t count, size_t size)
+{
+    void *p = Z_MallocNoUser((int)(count * size), PU_STATIC);
+    memset(p, 0, count * size);
+    return p;
+}
+void fm1_free(void *p) { Z_Free(p); }
+
+// ------------------------------------------------------------------ input
+void I_GetEvent(void)
+{
+    int key, down;
+    while (fm1_next_key(&key, &down)) {
+        event_t ev = {0};
+        ev.type = down ? ev_keydown : ev_keyup;
+        ev.data1 = key;
+        ev.data2 = down ? key : 0;
+        D_PostEvent(&ev);
+    }
+}
+void I_GetEventTimeout(int ms) { (void)ms; I_GetEvent(); }
+void I_BindInputVariables(void) {}
+void I_StartTextInput(int x1, int y1, int x2, int y2) { (void)x1; (void)y1; (void)x2; (void)y2; }
+void I_StopTextInput(void) {}
+
+// ------------------------------------------------------------------ system
+void I_Init(void)
+{
+    uint32_t n;
+    uint8_t *heap = fm1_heap(&n);
+    // short pointers reach 256 KB: the window ends where the heap ends and starts below it, so that it also
+    // covers the engine's statics placed just under the heap (short pointer 0 is NULL, hence the "- 4")
+    fm1_shortptr_base = heap + n - 0x40000 - 4;
+    whd_map_base = fm1_whd_base();
+}
+void I_PrintBanner(const char *msg) { puts(msg); }
+void I_PrintStartupBanner(const char *gamedescription) { puts(gamedescription); }
+boolean I_ConsoleStdout(void) { return true; }
+void I_BindVariables(void) {}
+void I_Tactile(int on, int off, int total) { (void)on; (void)off; (void)total; }
+void I_AtExit(atexit_func_t func, boolean run_on_error) { (void)func; (void)run_on_error; }
+void I_Quit(void) { panic("I_Quit"); for (;;) ; }
+boolean I_GetMemoryValue(unsigned int offset, void *value, int size) { (void)offset; (void)value; (void)size; return false; }
+
+// ------------------------------------------------------------------ sound: none yet
+static boolean fm1_snd_init(boolean use_sfx_prefix) { (void)use_sfx_prefix; return false; }
+static void fm1_snd_none(void) {}
+sound_module_t sound_pico_module = { .Init = fm1_snd_init, .Shutdown = fm1_snd_none };
+static int fm1_opl_init(unsigned int port_base) { (void)port_base; return 0; }
+static unsigned int fm1_opl_read(opl_port_t port) { (void)port; return 0; }
+static void fm1_opl_write(opl_port_t port, unsigned int value) { (void)port; (void)value; }
+static void fm1_opl_callback(uint64_t us, opl_callback_t callback, void *data) { (void)us; (void)callback; (void)data; }
+static void fm1_opl_paused(int paused) { (void)paused; }
+static void fm1_opl_tempo(unsigned int old_tempo, unsigned int new_tempo) { (void)old_tempo; (void)new_tempo; }
+// the music code writes OPL registers whether or not the driver came up: every entry must be callable
+const opl_driver_t opl_pico_driver = { .name = "fm1-none", .init_func = fm1_opl_init, .shutdown_func = fm1_snd_none,
+    .read_port_func = fm1_opl_read, .write_port_func = fm1_opl_write, .set_callback_func = fm1_opl_callback,
+    .clear_callbacks_func = fm1_snd_none, .lock_func = fm1_snd_none, .unlock_func = fm1_snd_none,
+    .set_paused_func = fm1_opl_paused, .adjust_callbacks_func = fm1_opl_tempo };
+void I_PicoSoundFade(bool in) { (void)in; }
+bool I_PicoSoundFading(void) { return false; }
+void OPL_Delay(uint64_t us) { (void)us; }
+
+// ------------------------------------------------------------------ no link-cable network, no flash saves
+boolean net_client_connected;
+void piconet_init(void) {}
+void piconet_start_host(int8_t deathmatch, int8_t epi, int8_t skill) { (void)deathmatch; (void)epi; (void)skill; }
+void piconet_start_client(void) {}
+void piconet_stop(void) {}
+bool piconet_client_check_for_dropped_connection(void) { return false; }
+void piconet_start_game(void) {}
+int piconet_get_lobby_state(lobby_state_t *state) { (void)state; return 0; }
+void piconet_new_local_tic(int tic) { (void)tic; }
+int piconet_maybe_recv_tic(int fromtic) { (void)fromtic; return -1; }
+void picoflash_sector_program(uint32_t flash_offs, const uint8_t *data) { (void)flash_offs; (void)data; }
+
+// savegames are not kept on the FM-1 yet: every slot reads as empty, writes fail
+void P_SaveGameGetExistingFlashSlotAddresses(flash_slot_info_t *slots, int count) { memset(slots, 0, sizeof *slots * (size_t)count); }
+boolean P_SaveGameWriteFlashSlot(int slot, const uint8_t *buffer, uint size, uint8_t *buffer4k) { (void)slot; (void)buffer; (void)size; (void)buffer4k; return false; }
+
+int main(void)
+{
+    I_Init();
+    D_DoomMain();
+    return 0;
+}
diff --git a/src/fm1/fm1_sdk.c b/src/fm1/fm1_sdk.c
