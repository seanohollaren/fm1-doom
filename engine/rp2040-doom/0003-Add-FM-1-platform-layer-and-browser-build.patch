+// FM-1 platform interface: what the Doom platform layer (fm1_platform.c, fm1_video.c) needs from the
+// machine underneath it. Three implementations are intended: the browser build (fm1_web.c), Felucca's HAL
+// on the real FM-1, and a test harness.
+#pragma once
+#include <stdint.h>
+
+// LCD: w x h pixels at (x, y) on the 240x240 panel; RGB565 in the panel's byte order (high byte first)
+void fm1_lcd_blit(unsigned x, unsigned y, unsigned w, unsigned h, const uint16_t *px);
+// milliseconds since start
+uint32_t fm1_millis(void);
+// next key change: 1 and *doom_key / *down filled in, or 0 if none
+int fm1_next_key(int *doom_key, int *down);
+// the game data (WHX) and the block the game heap lives in (it must end within 256 KB of the engine's
+// short-pointed statics: see fm1_web_ram.c)
+const uint8_t *fm1_whd_base(void);
+uint8_t *fm1_heap(uint32_t *size);
+
+void fm1_present(void);                  // fm1_video.c: show the frame the game has finished
+extern uint32_t fm1_frames;
