diff --git a/src/fm1/fm1_web.c b/src/fm1/fm1_web.c
index 389f693..29eef78 100644
--- a/src/fm1/fm1_web.c
+++ b/src/fm1/fm1_web.c
@@ -28,7 +28,37 @@ void fm1_poll_panel(uint32_t *notes, uint32_t *buttons, int8_t enc[FM1_NKNOB])
         fm1_enc[i] = 0;
     }
 }
-const uint8_t *fm1_whd_base(void) { return tiny_whd; }
+// The firmware stores the data file as two blocks. Do the same here, split at the lump boundary nearest the
+// middle, the two copies far apart and 64 KB of 0xA5 after the first: a read across the split shows at once.
+#undef malloc                             /* the build maps malloc to the game's own heap: these two blocks are not game memory */
+void *malloc(unsigned long);
+static uint8_t *fm1_part1, *fm1_part2;
+static uint32_t fm1_split = 0xFFFFFFFFu;
+static void fm1_web_split(void)
+{
+    uint32_t n, table, best = 0, total = sizeof tiny_whd;
+    if (fm1_part1)
+        return;
+    memcpy(&n, tiny_whd + 4, 4);
+    memcpy(&table, tiny_whd + 8, 4);
+    for (uint32_t i = 0; i <= n; i++) {                       /* lump offsets, low 24 bits; the last entry is the end */
+        uint32_t off;
+        memcpy(&off, tiny_whd + table + 4u * i, 4);
+        off &= 0xFFFFFFu;
+        if (off <= total / 2u && off > best)
+            best = off;
+    }
+    fm1_split = best;
+    fm1_part1 = malloc(best + 65536u);
+    memcpy(fm1_part1, tiny_whd, best);
+    memset(fm1_part1 + best, 0xA5, 65536u);
+    fm1_part2 = malloc(total - best);
+    memcpy(fm1_part2, tiny_whd + best, total - best);
+}
+const uint8_t *fm1_whd_base(void) { fm1_web_split(); return fm1_part1; }
+const uint8_t *fm1_whd_part2(uint32_t *split) { fm1_web_split(); *split = fm1_split; return fm1_part2; }
+void fm1_alive(void) {}
+EMSCRIPTEN_KEEPALIVE uint32_t fm1_web_split_at(void) { return fm1_split; }
 
 EMSCRIPTEN_KEEPALIVE void fm1_web_panel(uint32_t notes, uint32_t buttons) { fm1_notes = notes; fm1_buttons = buttons; }
 EMSCRIPTEN_KEEPALIVE void fm1_web_enc(int i, int steps) { if (i >= 0 && i < FM1_NKNOB) fm1_enc[i] += steps; }
diff --git a/src/w_file_memory.c b/src/w_file_memory.c
index 635324c..a2d1f5f 100644
--- a/src/w_file_memory.c
+++ b/src/w_file_memory.c
@@ -54,6 +54,8 @@ bi_decl(bi_program_feature(ADDR_FNAME));
 #else
 #if FM1
 const uint8_t *whd_map_base;   /* set by the platform before D_DoomMain (fm1_platform.c) */
+const uint8_t *whd_map_base2;  /* second block and the offset it starts at (w_wad.h lump_data) */
+uint32_t whd_split = 0xFFFFFFFFu;
 #else
 #if !PICO_ON_DEVICE
 #include "tiny.whd.h"
diff --git a/src/w_wad.h b/src/w_wad.h
index d9594c1..6eeb68f 100644
--- a/src/w_wad.h
+++ b/src/w_wad.h
@@ -95,9 +95,19 @@ extern const uint8_t *whd_map_base;
 static inline should_be_const uint8_t *lump_data(const lumpinfo_t *lump) {
 #if !USE_WHD
     return (const uint8_t *)lump->mem;
+#else
+#if FM1
+    // FM-1: the data file may be stored in two blocks (flash has no single run long enough: see firmware/pack.py).
+    // Offsets below whd_split are in the first block, the rest in the second. The split is on a lump boundary,
+    // and this function is the only place an offset becomes a pointer, so no lump is ever read across it.
+    extern const uint8_t *whd_map_base2;
+    extern uint32_t whd_split;
+    uint32_t off = (*lump)&0xffffffu;
+    return off < whd_split ? whd_map_base + off : whd_map_base2 + (off - whd_split);
 #else
     return whd_map_base + ((*lump)&0xffffffu);
 #endif
+#endif
 }
 #endif
 
