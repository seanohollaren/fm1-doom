 typedef struct {
-    char text[FM1_OSD_LINES][FM1_OSD_COLS + 1];
+    char text[FM1_OSD_LINES][FM1_OSD_LINE_CHARS + 1];
     uint8_t lines;                      // 0: nothing to show
+    uint8_t clipped;                    // not all of the message fitted (a word wider than a line, or too many lines)
     uint32_t until;                     // on the millisecond clock
 } fm1_osd_t;
 
-// Take a message: capitals, broken into lines at its spaces (a word longer than a line is cut; what does not fit
-// in the lines there are is dropped).
-static void fm1_osd_set(fm1_osd_t *o, const char *s, uint32_t now)
+// Take a message: capitals, broken into lines at its spaces, by the width in font pixels that `width` gives
+// for each character. A word wider than a line is left to run off the end of its own line; what does not fit in
+// the lines there are is dropped.
+static void fm1_osd_set(fm1_osd_t *o, const char *s, uint32_t now, int (*width)(int c))
 {
-    int line = 0, col = 0;
+    int line = 0, col = 0, x = 0;
+    o->clipped = 0;
     while (*s == ' ')
         s++;
     while (*s && line < FM1_OSD_LINES) {
-        int n = 0, i;
-        while (s[n] && s[n] != ' ')
-            n++;
-        if (col && col + 1 + n > FM1_OSD_COLS) {            // the word goes on the next line
-            o->text[line++][col] = 0;
-            col = 0;
+        int n = 0, w = 0, i;
+        for (; s[n] && s[n] != ' '; n++)
+            w += width(s[n] >= 'a' && s[n] <= 'z' ? s[n] - 32 : s[n]);
+        if (col && (x + FM1_OSD_SPACE + w > FM1_OSD_WIDTH || col + 1 + n > FM1_OSD_LINE_CHARS)) {
+            o->text[line++][col] = 0;       // the word goes on the next line
+            col = x = 0;
             continue;
         }
-        if (col)
+        if (col) {
             o->text[line][col++] = ' ';
-        for (i = 0; i < n && col < FM1_OSD_COLS; i++) {
-            char c = s[i];
-            o->text[line][col++] = (char)(c >= 'a' && c <= 'z' ? c - 32 : c);
+            x += FM1_OSD_SPACE;
         }
+        for (i = 0; i < n && col < FM1_OSD_LINE_CHARS; i++)
+            o->text[line][col++] = (char)(s[i] >= 'a' && s[i] <= 'z' ? s[i] - 32 : s[i]);
+        x += w;
+        if (x > FM1_OSD_WIDTH || i < n)
+            o->clipped = 1;
         s += n;
         while (*s == ' ')
             s++;
     }
+    if (*s)
+        o->clipped = 1;
     if (line < FM1_OSD_LINES)
         o->text[line++][col] = 0;
     o->lines = (uint8_t)(col || line > 1 ? line : 0);
@@ -123,37 +66,3 @@ static void fm1_osd_set(fm1_osd_t *o, const char *s, uint32_t now)
 }
 
 static inline int fm1_osd_on(const fm1_osd_t *o, uint32_t now) { return o->lines && (int32_t)(o->until - now) > 0; }
-// how many panel rows the band takes from its top
-static inline int fm1_osd_height(const fm1_osd_t *o) { return 2 * FM1_OSD_PAD + o->lines * FM1_OSD_LINE_H - 4; }
-
-// One panel row of `width` pixels (RGB565 with its two bytes swapped, as the panel takes them), `y` rows below
-// the top of the band: the picture is dimmed to a quarter, and the row's dots are written in white.
-static void fm1_osd_row(const fm1_osd_t *o, uint16_t *px, int width, int y)
-{
-    int i, r, line, dot;
-    const char *t;
-    if (y < 0 || y >= fm1_osd_height(o))
-        return;
-    for (i = 0; i < width; i++) {
-        uint16_t v = (uint16_t)(px[i] << 8 | px[i] >> 8);
-        v = (uint16_t)((v >> 2) & 0x39E7u);
-        px[i] = (uint16_t)(v << 8 | v >> 8);
-    }
-    r = y - FM1_OSD_PAD;
-    if (r < 0)
-        return;
-    line = r / FM1_OSD_LINE_H;
-    dot = r % FM1_OSD_LINE_H / 2;
-    if (line >= o->lines || dot >= 7)
-        return;
-    t = o->text[line];
-    for (i = 0; t[i]; i++)
-        ;
-    px += (width - (i * FM1_OSD_CELL_W - 2)) / 2;           // the line centred
-    for (; *t; t++, px += FM1_OSD_CELL_W) {
-        unsigned c = (unsigned char)*t - 32u, bits = c < 64u ? FM1_OSD_FONT[c][dot] : 0u;
-        for (i = 0; bits; i += 2, bits = (bits << 1) & 0x1Fu)
-            if (bits & 0x10u)
-                px[i] = px[i + 1] = 0xFFFFu;
-    }
-}
diff --git a/src/fm1/fm1_video.c b/src/fm1/fm1_video.c
index 719d38a..7c1fb72 100644
--- a/src/fm1/fm1_video.c
+++ b/src/fm1/fm1_video.c
@@ -610,11 +610,70 @@ void fm1_view_next(void)
 }
 const char *fm1_view_name(void) { return FM1_VIEW_NAMES[fm1_view]; }
 
-// what a knob or button has just done, written large across the top of the picture (fm1_osd.h)
+// What a knob or button has just done, written across the top of the picture in the game's own message font at
+// twice its size (fm1_osd.h breaks it into lines). The letters are the font's patches, STCFN033 ('!') to
+// STCFN095 ('_'), drawn by draw_vpatch as the game's own text is, but a row at a time into a row of their own,
+// which then goes onto two panel rows with every pixel doubled.
 #include "fm1_osd.h"
-#define FM1_OSD_TOP 4                      /* panel rows from the top of the picture to the band */
+#define FM1_OSD_TOP 4                      /* panel rows from the top of the picture to the first line */
+#define FM1_OSD_LEFT 4                     /* ... and pixels from its left edge */
+#define FM1_OSD_CLEAR 0x07E1u              /* marks a pixel no letter covers (a green the font's reds never are) */
 static fm1_osd_t fm1_osd;
-void fm1_osd_say(const char *text) { fm1_osd_set(&fm1_osd, text, fm1_millis()); }
+static uint16_t fm1_osd_doff[FM1_OSD_LINES][FM1_OSD_LINE_CHARS];   /* how far into each letter's data this frame has got */
+static uint16_t fm1_osd_px[FM1_OSD_WIDTH + 32];                    /* one row of one line, in the font's own pixels */
+
+static patch_t *fm1_osd_letter(int c)      /* NULL: a space, or nothing the font has */
+{
+    return c >= '!' && c <= '_' ? resolve_vpatch_handle(vpatch_n(VPATCH_STCFN033, c - '!')) : NULL;
+}
+static int fm1_osd_width(int c)
+{
+    patch_t *patch = fm1_osd_letter(c);
+    return patch ? vpatch_width(patch) : FM1_OSD_SPACE;
+}
+void fm1_osd_say(const char *text) { fm1_osd_set(&fm1_osd, text, fm1_millis(), fm1_osd_width); }
+
+// One panel row (pixels with their bytes swapped, as the panel takes them), y rows below the top of the first
+// line. Rows must come in order, top to bottom, each once a frame: a letter's data is read a row at a time.
+static void fm1_osd_row(uint16_t *row, int y)
+{
+    int line, r, x, i;
+    if (y < 0)
+        return;
+    line = y / (2 * FM1_OSD_PITCH);
+    r = y % (2 * FM1_OSD_PITCH);
+    if (line >= fm1_osd.lines || r >= 2 * FM1_OSD_ROWS)
+        return;
+    if (!(r & 1)) {                        /* a new row of the font: drawn once, shown on this panel row and the next */
+        const char *t = fm1_osd.text[line];
+        for (x = 0; x < FM1_OSD_WIDTH + 32; x++)
+            fm1_osd_px[x] = FM1_OSD_CLEAR;
+        for (i = 0, x = 0; t[i] && x < FM1_OSD_WIDTH; i++) {
+            patch_t *patch = fm1_osd_letter(t[i]);
+            if (!patch) {
+                x += FM1_OSD_SPACE;
+                continue;
+            }
+            if ((r >> 1) < vpatch_height(patch) && vpatch_width(patch) <= 32) {
+                vpatchlist_t vp;
+                memset(&vp, 0, sizeof vp);
+                vp.entry.x = (uint32_t)x;
+                fm1_osd_doff[line][i] = (uint16_t)draw_vpatch(fm1_osd_px, patch, &vp, fm1_osd_doff[line][i]);
+            }
+            x += vpatch_width(patch);
+        }
+    }
+    row += FM1_OSD_LEFT;
+    for (x = 0; x < FM1_OSD_WIDTH; x++) {
+        uint16_t v = fm1_osd_px[x];
+        if (v != FM1_OSD_CLEAR)
+            row[2 * x] = row[2 * x + 1] = (uint16_t)(v << 8 | v >> 8);
+    }
+}
+#if FM1_WEB
+// (browser build, test hook) the message showing now: its lines, plus 256 if not all of it fitted; 0 for none
+int fm1_osd_probe(void) { return fm1_osd_on(&fm1_osd, fm1_millis()) ? fm1_osd.lines + 256 * fm1_osd.clipped : 0; }
+#endif
 
 static uint32_t fm1_line[SCREENWIDTH / 2 + 2];             /* one composed scanline, RGB565 (word aligned) */
 // two strip buffers, used in turn: the platform may still be sending one (DMA) while the next is composed.
@@ -637,6 +696,8 @@ void fm1_present(void) {
     int out_y = 0, n = 0, acc = 0;
     const int rows = FM1_VIEW_ROWS[fm1_view], view_y = (FM1_LCD_H - rows) / 2;
     const int osd = fm1_osd_on(&fm1_osd, fm1_millis());
+    if (osd)
+        memset(fm1_osd_doff, 0, sizeof fm1_osd_doff);       /* every letter from its first row */
     uint16_t *fm1_strip = fm1_strips[fm1_strip_i];
     fm1_alive();
     fm1_audio_pump();
@@ -684,7 +745,7 @@ void fm1_present(void) {
         for (acc += rows; acc >= SCREENHEIGHT; acc -= SCREENHEIGHT) {
             fm1_squeeze(fm1_strip + n * FM1_LCD_W, dest);
             if (osd)
-                fm1_osd_row(&fm1_osd, fm1_strip + n * FM1_LCD_W, FM1_LCD_W, out_y + n - FM1_OSD_TOP);
+                fm1_osd_row(fm1_strip + n * FM1_LCD_W, out_y + n - FM1_OSD_TOP);
             if (++n == FM1_STRIP_H) {
                 fm1_lcd_blit(0, (unsigned)(view_y + out_y), FM1_LCD_W, (unsigned)n, fm1_strip);
                 fm1_strip = fm1_strips[fm1_strip_i ^= 1];
